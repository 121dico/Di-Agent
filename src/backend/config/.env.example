# Backend report data source credentials.
# Copy this file to .env.local and fill values on the server. The backend loads
# .env.local automatically, while Git ignores that file and its real secrets.

# Direct HiveServer2 connection for the Data page. Never commit real credentials.
# The host and port must be reachable from the backend server, not just a browser.
DI_AGENT_HIVE_HOST=
DI_AGENT_HIVE_PORT=8084
DI_AGENT_HIVE_USER=
DI_AGENT_HIVE_PASSWORD=
# Required for connection: bind this personal Hadoop account to one Di Agent user UUID.
# Without this binding the shared connection remains disabled.
DI_AGENT_HIVE_OWNER_USER_ID=

# Data Map Open API pilot: independent client/token, not Boss Cookie or Hive credentials.
# Leave all fields empty until the source owner approves a formal endpoint and applicant.
DI_AGENT_DATA_MAP_BASE_URL=
DI_AGENT_DATA_MAP_CLIENT=
DI_AGENT_DATA_MAP_TOKEN=
DI_AGENT_DATA_MAP_OWNER_USER_ID=

# Price-sensitive report source. Prefer APP_SECRET for dynamic signing. When
# only a replayable signed request is available, leave APP_SECRET empty and
# provide SIGN plus SIGN_DATE instead.
REPORT_PRICE_APP_KEY=
REPORT_PRICE_APP_SECRET=
REPORT_PRICE_SIGN=
REPORT_PRICE_SIGN_DATE=

# Main-station 180-day downstream source.
REPORT_MAIN_STATION_APP_KEY=
REPORT_MAIN_STATION_SIGN=
REPORT_MAIN_STATION_DATE=

# Delivery-analysis audience snapshot source.
REPORT_ADS_DELIVERY_APP_KEY=
REPORT_ADS_DELIVERY_SIGN=
REPORT_ADS_DELIVERY_SIGN_DATE=

# Delivery-analysis user daily effect source.
REPORT_ADS_DELIVERY_EFFECT_APP_KEY=
REPORT_ADS_DELIVERY_EFFECT_SIGN=
REPORT_ADS_DELIVERY_EFFECT_SIGN_DATE=

# Delivery-analysis coupon funnel source.
REPORT_ADS_DELIVERY_COUPON_FUNNEL_APP_KEY=
REPORT_ADS_DELIVERY_COUPON_FUNNEL_SIGN=
REPORT_ADS_DELIVERY_COUPON_FUNNEL_SIGN_DATE=

# Main DUID coupon and sort source.
REPORT_MAIN_DUID_COUPON_SORT_APP_KEY=
REPORT_MAIN_DUID_COUPON_SORT_SIGN=
REPORT_MAIN_DUID_COUPON_SORT_SIGN_DATE=
